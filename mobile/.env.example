# Copy to `.env`. The URL must match where your Express server runs and end with `/v1/api/`.

# Same machine as web (client/.env) — Expo Web + iOS simulator:
# EXPO_PUBLIC_API_URL=http://localhost:5000/v1/api/

# Android emulator (Windows/macOS):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/v1/api/

# Physical device with Expo Go (replace with your PC's IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/v1/api/

# Production / cloud only:
# EXPO_PUBLIC_API_URL=https://university-management-system-ca42.onrender.com/v1/api/
